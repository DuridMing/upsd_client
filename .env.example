# 複製此檔為 .env 並填入你的設定

# ── LINE Messaging API ────────────────────────────────────────────────────────
# LINE Developers Console → 你的 Messaging API Channel
CHANNEL_SECRET=CHANNEL_SECRET
LINE_ACCESS_TOKEN=LINE_ACCESS_TOKEN

# 接收通知的管理員 LINE User ID（與 Bot 對話後，於 Webhook 或 OA Manager 取得）
ADMIN_USER_ID=ADMIN_USER_ID

# ── NUT daemon ────────────────────────────────────────────────────────────────
# 容器改用 ports 映射（bridge 網路）後，容器的 localhost 不是宿主機，請依情況填：
#   • NUT 在「同一台主機」  → host.containers.internal（podman 會自動指向宿主機）
#   • NUT 在「別台主機」    → 該主機的 IP（例如 192.168.1.10）
NUT_HOST=host.containers.internal
NUT_PORT=3493
UPS_NAME=eaton5cs
# NUT 帳號（upsd.users 中設定的帳密；若 NUT 允許匿名查詢可留空）
NUT_USER=
NUT_PASSWORD=

# ── Web 介面 ──────────────────────────────────────────────────────────────────
PORT=8080
ELECTRICITY_RATE=0
