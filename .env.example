# 複製此檔為 .env 並填入你的設定

# ── 通知（NotifySystem）──────────────────────────────────────────────────────
# NotifySystem 的 webhook 來源網址（整合 → 來源 → 新增 webhook，複製 /hooks/... 網址）。
# 要送到 LINE 還是其他平台，在 NotifySystem 的來源「通知對象」設定。
# 網址裡的 key 等同密碼，不要提交到 git。
NOTIFY_HOOK_URL=http://192.168.77.241:8000/hooks/YOUR_HOOK_KEY

# ── NUT daemon ────────────────────────────────────────────────────────────────
# 容器改用 ports 映射（bridge 網路）後，容器的 localhost 不是宿主機，請依情況填：
#   • NUT 在「同一台主機」  → host.containers.internal（podman 會自動指向宿主機）
#   • NUT 在「別台主機」    → 該主機的 IP（例如 192.168.1.10）
NUT_HOST=host.containers.internal
NUT_PORT=3493
UPS_NAME=eaton5cs
# NUT 帳號（upsd.users 中設定的帳密；若 NUT 允許匿名查詢可留空）
NUT_USER=
NUT_PASSWORD=

# ── Web 介面 ──────────────────────────────────────────────────────────────────
PORT=8080
ELECTRICITY_RATE=0
